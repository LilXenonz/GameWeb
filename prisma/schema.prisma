generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  password     String?   // Legacy plaintext (for migration only)
  salt         String?   // Salt for password hashing
  hash         String?   // PBKDF2 hashed password
  email        String?
  createdAt    DateTime  @default(now())
  
  profileImageId String? @unique
  profileImage   Image?   @relation("UserProfileImage", fields: [profileImageId], references: [id])
  
  characters Character[]
  games      Game[]
  images     Image[]    @relation("UserImages")
  sessions   Session[]
  messages   Message[]
}

model Message {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  lastUsed  DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  ipAddress String? 
  deviceName String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Character {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  
  imageId     String? @unique
  image       Image?   @relation("CharacterImage", fields: [imageId], references: [id])
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  games       Game[]
  totalGames  Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
}

model Image {
  id          String   @id @default(uuid())
  name        String   // Original filename
  type        String   // MIME type (e.g., 'image/jpeg')
  data        String   // Base64 encoded image data
  size        Int      // File size in bytes
  createdAt   DateTime @default(now())
  userId      String   // Owner user ID
  
  userProfile    User?      @relation("UserProfileImage")
  characterImage Character? @relation("CharacterImage")
  
  user           User       @relation("UserImages", fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id          String   @id @default(uuid())
  won         Boolean
  opponent    String?
  note        String?
  createdAt   DateTime @default(now())
  
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}